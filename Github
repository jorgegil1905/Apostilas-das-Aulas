
build.yml

name: Build Pipeline                # Nome do workflow exibido no GitHub Actions

on:                                 # Define quando o pipeline será executado
  push:                             # Dispara quando há push
    branches: [ "develop", "main" ] # Apenas nessas branches
  pull_request:                     # Também executa quando abrir PR

jobs:                               # Define os jobs do pipeline

  build:                            # Nome do job
    runs-on: ubuntu-latest          # Runner onde será executado

    steps:                          # Passos executados em sequência

    - uses: actions/checkout@v4     # Baixa o código do repositório

    - name: Setup Java              # Nome descritivo do passo
      uses: actions/setup-java@v4   # Action oficial para instalar Java
      with:
        distribution: temurin       # Distribuição do Java
        java-version: 17            # Versão Java usada
        cache: maven                # Cache dependências Maven

    - name: Run tests               # Nome do passo
      run: mvn clean verify         # Compila + executa testes
                                    # validate, compile, test, package e verify

    - name: Login Docker            # Autentica no registry Docker
                                    # echo envia senha sem ir p/ o login
      run: echo ${{ secrets.DOCKER_PASS }} | docker login -u ${{ secrets.DOCKER_USER }} --password-stdin

    - name: Build Image             # Cria imagem Docker p/ usuario-repositorio
      run: docker build -t ${{ secrets.DOCKER_USER }}/springboot:${{ github.sha }} .

    - name: Push Image              # Envia imagem ao registry / usuario-repositorio
      run: docker push ${{ secrets.DOCKER_USER }}/springboot:${{ github.sha }}

