deployment.yml

apiVersion: apps/v1             # Versão da API do Kubernetes
kind: Deployment                # Tipo de recurso (implantação atualizando os pods)

metadata:
  name: springboot              # Nome do deployment

spec:
  replicas: 2                   # Quantidade de pods rodando
                                # POD é a caixa onde vive um ou mais containers Docker

  selector:
    matchLabels:
      app: springboot           # Label usada para identificar pods

  template:                     # Template de pod

    metadata:
      labels:
        app: springboot         # Label aplicada aos pods

    spec:
      containers:
      - name: app               # Nome do container
        image: springboot:latest # Imagem usada
        ports:
        - containerPort: 8080   # Porta exposta dentro do pod


