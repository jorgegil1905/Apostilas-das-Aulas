service.yml

apiVersion: v1                 # API do recurso
kind: Service                  # Tipo Service(conecta os usários a aplicação)

metadata:
  name: springboot-serv ice     # Nome do serviço

spec:
  type: ClusterIP              # Tipo interno do cluster

  selector:
    app: springboot            # Seleciona pods com essa label

  ports:
  - port: 80                   # Porta exposta no cluster
    targetPort: 8080           # Porta do container


