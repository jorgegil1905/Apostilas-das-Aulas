deploy.yml

name: Deploy Pipeline                  # Nome do workflow

on:                                     # Evento que dispara
  workflow_dispatch:                    # Permite rodar manualmente
  push:
    tags:
      - "v*"                            # Executa quando criar tag versão

jobs:

  deploy:
    runs-on: ubuntu-latest              # Runner Linux

    steps:

    - name: Setup Kubectl               # Instala kubectl
      uses: azure/setup-kubectl@v4

    - name: Set kubeconfig              # Configura acesso ao cluster
      run: |
        mkdir -p $HOME/.kube            # Cria pasta kubectl(oculta)
        echo "${{ secrets.KUBE_CONFIG }}" > $HOME/.kube/config  # Grava credencial no config

    - name: Deploy to cluster           # Passo deploy
      run: |
        kubectl set image deployment/springboot app=${{ secrets.DOCKER_USER }}/springboot:${{ github.sha }} # atualiza imagem
        kubectl rollout status deployment/springboot # aguarda rollout

